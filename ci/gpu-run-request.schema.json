{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sandy-t-shelvan/SimFoundry/blob/Main_duplicate/ci/gpu-run-request.schema.json",
  "title": "GPU smoke request",
  "description": "Trigger document only. It cannot name an instance. The workflow always uses instance 60254439 and rejects every other field. This schema file is not the trigger path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["ticket_id", "reason"],
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]+-[0-9]+$",
      "minLength": 3,
      "maxLength": 32
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\n\\r]+$"
    }
  }
}
